# SAVIO 3.0 works without any environment variables, accounts or database.
# Optional server-only AI integration (never NEXT_PUBLIC).
SAVIO_AI_KEY=
SAVIO_AI_MODEL=gpt-4.1-mini
# Required for enabling AI on a production/public deployment: Upstash-compatible
# Redis REST URL and token. App and local insights work without these.
SAVIO_RATE_LIMIT_URL=
SAVIO_RATE_LIMIT_TOKEN=
# Existing OPENAI_API_KEY / OPENAI_MODEL server bindings are also supported.
